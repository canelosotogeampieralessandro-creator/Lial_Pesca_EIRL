# ---------------------------------------------------------------
# LISTA BLANCA. Esta carpeta guarda facturas, liquidaciones y
# estados de cuenta con RUC, DNI e importes reales, y el
# repositorio es PUBLICO. Por eso se ignora todo por defecto y
# solo se autoriza, una por una, la ruta que si debe publicarse.
#
# Para publicar algo nuevo, agregalo abajo con "!" delante.
# ---------------------------------------------------------------

# 1. Ignorar absolutamente todo
/*

# 2. Autorizar solo lo que es codigo, icono o documentacion
!/.gitignore
!/.nojekyll
!/README.md
!/PRODUCT.md
!/DESIGN.md
!/index.html
!/manifest.json
!/serve.js
!/icono.svg
!/icono.png
!/icono-192.png

# 3. Nunca publicar datos, ni siquiera si caen en la raiz
/respaldo*.json
/compras*.csv
/ventas*.csv
/factoring*.csv
/fletes*.csv
*.xlsx
*.xls
*.pdf

# 4. Basura del sistema
.DS_Store
Thumbs.db
desktop.ini
